generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model clubs {
  club_id  Int     @id @default(autoincrement())
  name     String  @unique @db.VarChar(255)
  province String @db.VarChar(25)
  teams    teams[]
}

model teams {
  team_id           Int                 @id @default(autoincrement())
  club_id           Int
  name              String              @db.VarChar(100)
  coach_memberships coach_memberships[]
  invites           invites[]
  sessions          sessions_teams[]
  members           team_memberships[]
  club              clubs               @relation(fields: [club_id], references: [club_id], onDelete: Cascade)

  @@unique([club_id, name])
}

model team_memberships {
  team_membership_id Int       @id @default(autoincrement())
  athlete_id         Int
  team_id            Int
  start_date         DateTime? @db.Date
  end_date           DateTime? @db.Date
  athlete            athletes  @relation(fields: [athlete_id], references: [athlete_id], onDelete: Cascade)
  team               teams     @relation(fields: [team_id], references: [team_id], onDelete: Cascade)

  @@unique([athlete_id, team_id, start_date])
  @@index([athlete_id])
  @@index([team_id])
}

model athletes {
  athlete_id         Int                @id @default(autoincrement())
  athlete_first_name String             @db.VarChar(100)
  athlete_last_name  String             @db.VarChar(100)
  birthday           DateTime?          @db.Date
  gender             String             @db.VarChar(10)
  team               String?            @db.VarChar(255)
  age_group          String?            @db.VarChar(10)
  aca_id             Int?               @unique
  fis_id             Int?               @unique
  attendance         attendance[]
  invites            invites[]
  parents            parents[]
  team_memberships   team_memberships[]
  users              users[]
  fitness_testing_results fitness_testing_results[]
}

model sessions {
  session_id                     Int              @id @default(autoincrement())
  session_day                    DateTime?        @db.Date
  start_time                     DateTime?        @db.Time(6)
  end_time                       DateTime?        @db.Time(6)
  location                       String?          @db.VarChar(50)
  discipline                     String?          @db.VarChar(20)
  snow_conditions                String?          @db.VarChar(50)
  vis_conditions                 String?          @db.VarChar(50)
  terrain_type                   String?          @db.VarChar(50)
  num_freeski_runs               Int?
  num_drill_runs                 Int?
  num_educational_course_runs    Int?
  num_gates_educational_course   Int?
  num_race_training_course_runs  Int?
  num_gates_race_training_course Int?
  num_race_runs                  Int?
  num_gates_race                 Int?
  general_comments               String?          @db.VarChar(250)
  created_by                     Int?
  attendance                     attendance[]
  creator                        users?           @relation(fields: [created_by], references: [user_id])
  session_teams                  sessions_teams[]
}

model sessions_teams {
  session_team_id Int      @id @default(autoincrement())
  session_id      Int
  team_id         Int
  session         sessions @relation(fields: [session_id], references: [session_id], onDelete: Cascade)
  team            teams    @relation(fields: [team_id], references: [team_id], onDelete: Cascade)

  @@unique([session_id, team_id])
  @@index([session_id])
  @@index([team_id])
}

model attendance {
  attendance_id             Int      @id @default(autoincrement())
  athlete_id                Int
  session_id                Int
  individual_comments       String?  @db.VarChar(500)
  drill_runs                Int?
  educational_course_runs   Int?
  freeski_runs              Int?
  race_runs                 Int?
  race_training_course_runs Int?
  athlete                   athletes @relation(fields: [athlete_id], references: [athlete_id], onDelete: Cascade)
  session                   sessions @relation(fields: [session_id], references: [session_id], onDelete: Cascade)

  @@unique([athlete_id, session_id])
  @@index([athlete_id])
  @@index([session_id])
}

model users {
  user_id           Int                 @id @default(autoincrement())
  first_name        String?             @db.VarChar(250)
  last_name         String?             @db.VarChar(250)
  email             String?             @unique @db.VarChar(100)
  password          String?             @db.VarChar(200)
  status            String?
  google_id         String?             @unique
  athlete_id        Int?
  coach_memberships coach_memberships[]
  parents           parents[]
  created_sessions  sessions[]
  athlete           athletes?           @relation(fields: [athlete_id], references: [athlete_id])
}

model coach_memberships {
  coach_membership_id Int   @id @default(autoincrement())
  user_id             Int
  team_id             Int
  team                teams @relation(fields: [team_id], references: [team_id], onDelete: Cascade)
  user                users @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@unique([user_id, team_id])
  @@index([user_id])
  @@index([team_id])
}

model parents {
  athlete_id Int
  user_id    Int
  athlete    athletes @relation(fields: [athlete_id], references: [athlete_id], onDelete: Cascade)
  user       users    @relation(fields: [user_id], references: [user_id], onDelete: Cascade)

  @@id([athlete_id, user_id])
}

model invites {
  invite_id  Int       @id @default(autoincrement())
  athlete_id Int?
  token      String    @unique @db.VarChar(128)
  role       String
  expires_at DateTime  @db.Timestamp(6)
  used       Boolean?  @default(false)
  created_at DateTime? @default(now()) @db.Timestamp(6)
  team_id    Int?
  athlete    athletes? @relation(fields: [athlete_id], references: [athlete_id], onDelete: Cascade)
  team       teams?    @relation(fields: [team_id], references: [team_id], onDelete: Cascade)

  @@index([athlete_id])
  @@index([team_id])
}

model auth_sessions {
  sid    String   @id @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_auth_sessions_expire")
}


model fitness_testing_results {
  fitness_testing_result_id Int      @id @default(autoincrement())
  athlete_id               Int
  test_date                DateTime @db.Date

  age_category             String   @db.VarChar(20)
  return_to_sport          Boolean  @default(false)

  height                   Decimal? @db.Decimal(5, 2)
  weight                   Decimal? @db.Decimal(5, 2)

  ais_beep_level            Decimal?
  beep_max_hr               Int?

  hex_cw_t1                 Decimal?
  hex_cw_t2                 Decimal?
  hex_cw_t3                 Decimal?
  hex_ccw_t1                Decimal?
  hex_ccw_t2                Decimal?
  hex_ccw_t3                Decimal?

  slj_t1                    Decimal?
  slj_t2                    Decimal?
  slj_t3                    Decimal?

  dlpj_t1                   Decimal?
  dlpj_t2                   Decimal?
  dlpj_t3                   Decimal?

  slpj_left_t1              Decimal?
  slpj_left_t2              Decimal?
  slpj_left_t3              Decimal?
  slpj_right_t1             Decimal?
  slpj_right_t2             Decimal?
  slpj_right_t3             Decimal?

  pushups                   Int?
  pullups                   Int?
  situps                    Int?
  bar_hang                  Decimal?

  box_jumps_30s              Int?
  box_jumps_60s              Int?
  box_jumps_total            Int?

  athlete                   athletes @relation(fields: [athlete_id], references: [athlete_id], onDelete: Cascade)

  @@index([athlete_id])
  @@index([test_date])
}

model fitness_tests {
  test_id               Int      @id @default(autoincrement())
  name                  String   @unique @db.VarChar(100)
  unit                  String?  @db.VarChar(30)
  comparison_direction  String   @db.VarChar(10)

  categories            fitness_test_categories[]
  tier_rules fitness_tier_rules[]
}

model fitness_test_categories {
  cat_id         Int      @id @default(autoincrement())
  test_id        Int
  age_category   String?  @db.VarChar(20)
  gender         String?  @db.VarChar(10)
  name           String   @db.VarChar(100)

  test           fitness_tests          @relation(fields: [test_id], references: [test_id], onDelete: Cascade)

  scoring_rules  fitness_scoring_rules[]

  @@index([test_id])
  @@index([age_category, gender])
}

model fitness_scoring_rules {
  rule_id     Int      @id @default(autoincrement())
  cat_id      Int
  threshold   Decimal  @db.Decimal(10, 3)
  points      Int

  category    fitness_test_categories @relation(fields: [cat_id], references: [cat_id], onDelete: Cascade)

  @@unique([cat_id, threshold])
  @@index([cat_id])
}


model fitness_tiers {
  tier_id   Int    @id @default(autoincrement())
  name      String @unique @db.VarChar(50)
  rank      Int

  rules     fitness_tier_rules[]
  overall_rules  fitness_overall_tier_rules[]
}


model fitness_tier_categories {
  tier_category_id Int     @id @default(autoincrement())
  age_category     String  @db.VarChar(20)
  gender           String? @db.VarChar(10)

  rules            fitness_tier_rules[]
  overall_rules    fitness_overall_tier_rules[]

  @@unique([age_category, gender])
}

model fitness_tier_rules {
  tier_rule_id     Int      @id @default(autoincrement())
  tier_category_id Int
  tier_id          Int
  test_id          Int
  threshold        Decimal  @db.Decimal(10, 3)

  tier_category fitness_tier_categories @relation(fields: [tier_category_id], references: [tier_category_id], onDelete: Cascade)
  tier fitness_tiers @relation(fields: [tier_id], references: [tier_id], onDelete: Cascade)
  test fitness_tests @relation(fields: [test_id], references: [test_id], onDelete: Cascade)

  @@unique([tier_category_id, tier_id, test_id])
  @@index([tier_category_id])
  @@index([tier_id])
  @@index([test_id])
}


model fitness_overall_tier_rules {
  overall_tier_rule_id Int      @id @default(autoincrement())
  tier_category_id     Int
  tier_id              Int
  threshold            Decimal  @db.Decimal(10, 3)   // total combine points

  tier_category  fitness_tier_categories @relation(fields: [tier_category_id], references: [tier_category_id], onDelete: Cascade)
  tier           fitness_tiers           @relation(fields: [tier_id], references: [tier_id], onDelete: Cascade)

  @@unique([tier_category_id, tier_id])
  @@index([tier_category_id])
  @@index([tier_id])
}